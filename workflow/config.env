# workflow/config.env — the ONLY file to edit when porting this lane to another repo.
#
# Copy `workflow/` into the new repo, add the two lines to its CLAUDE.md (see WORKFLOW.md,
# "Porting this lane"), and adjust anything below that is wrong. Everything here has a working
# default, so an unedited copy runs — the defaults are chosen so that a *wrong* value fails
# loudly rather than quietly acting on the wrong repository.
#
# Read by both the shell scripts (sourced) and issue.py (parsed), so keep it to plain
# KEY=value with no expansion, no quotes needed, and no shell syntax.

# The tracker's `repo` field, and the thing that separates one repo's issues from another's in
# a SHARED PocketBase instance.
#
# ⚠ LEAVE IT EMPTY TO DERIVE IT FROM `git remote get-url origin`. That is the recommended
# setting: a hardcoded slug that survives a copy-paste into a new repo is the one failure mode
# that silently files issues against the repo you came from, where they look completely normal.
# Set it explicitly only for a repo with no origin remote.
REPO_SLUG=

# The branch work merges into.
BASE_BRANCH=main

# Who commits, and who reviews — MOVED to the FerroStep roster: config.yaml at the repo
# root, the ONE place identities are set (owner, 2026-08-24). Resolve with
# `ferrostep agent-env [--agent <title>]`; nothing here may restate a name or an email,
# for the same reason the floor below is not restated in prose.

# ⚠⚠ THE MERGE GATE'S SEVERITY FLOOR — THE ONE PLACE IT IS SET (owner, 2026-08-20).
#
# An issue at this severity or ABOVE blocks a merge. Anything below it RIDES: it stays open,
# the branch lands, and it belongs on a follow-up branch.
#
#     low | medium | high | critical
#
# WHY IT LIVES HERE RATHER THAN IN THE CODE. The rule was previously spelled out in prose in
# eight places — scripts, personas, the workflow map, a manifest, test docstrings — and three
# separate sweeps failed to find them all; the guard written to end the sweeps then shipped
# green while blind to a ninth. The owner's ruling on that (2026-08-20): settle it everywhere
# it surfaces, AND make it reconfigurable from a single place. This is that place.
#
# ⚠ SO DO NOT RESTATE THE VALUE IN PROSE. Documents should say "the floor set in
# workflow/config.env", never "MEDIUM and above blocks" — a second copy of a configurable
# value is a copy that goes stale the moment someone reconfigures it, which is the exact
# failure this setting exists to end. `tests/test_merge_gate_description.py` enforces that.
#
# ⚠ AN UNSET OR UNRECOGNISED VALUE BLOCKS EVERYTHING. There is deliberately no "off": a floor
# that fails open is not a floor, and a typo here must not silently widen what can merge.
MERGE_SEVERITY_FLOOR=medium

# The per-issue fix-pass cap MOVED to the lane definition (phase 2, 2026-08-24): it is
# `agent_passes.max` in workflow/sonora-lane.json, where exhaustion also names its route
# (`on_exhausted`) — one fact, enforced by the engine, instead of a number here and a
# procedure sentence elsewhere that can disagree.

# Comment length cap. The owner set one because a reviewer averaged 1839 characters and detail
# belongs in the issue body, which allows 200,000.
COMMENT_MAX=1500

# Sibling checkouts the REVIEWER may read (colon-separated; `~` allowed; relative paths resolve
# from the repo root). Sonora *describes* mechanisms that are *implemented* in AI-Lab-AMD — the
# PocketBase hook behind `user_decision` above all — and a reviewer that cannot see them has to
# file "unverifiable" instead of checking. Leave empty if there are none; the reviewer then
# simply gets no --add-dir.
# ⚠ EVERY entry that exists is granted, not just the first (#347, 2026-08-27). This was a
# fallback chain wearing the spelling of a list — the two AI-Lab-AMD entries are the same
# repo by two paths, which is why the single-value shape looked right while there was one
# sibling. FerroStep is here because REVIEWER.md routes findings to it and tells the
# reviewer to VERIFY the boundary rather than remember it; that instruction was
# unfollowable while the launcher could not grant the repo. Read-only, and FerroStep is a
# public repo, so nothing lab-internal is exposed by the grant.
SIBLING_REPO_CANDIDATES=../../AI-Lab-AMD:~/Projects/Artificial-Humanity/AI-Lab-AMD:~/Projects/Artificial-Humanity/FerroStep

# --- the developer's self-check, before a review pass is spent -------------
# WHEN to run it, by REVIEW index, 1-based.
#   none    — never. Also what an unset or empty value means.
#   first   — before review 1 only.
#   all     — before every review.
#   1,4     — before those reviews specifically.
# ⚠ The indices are REVIEWS, not fix passes. A definition allowing 3 fix passes allows 4
#   reviews, so `1,4` is first-and-last HERE and not everywhere — the ceiling is derived from
#   sonora-lane.json, never typed. An unrecognised value or an index above the ceiling is a
#   REFUSAL, not a fallback to `none`: a check that never fires is indistinguishable from one
#   that ran clean.
SELF_REVIEW_AT=all

# A command that must exit 0 at each scheduled self-check. Empty means no mechanical gate,
# only the prompted checklist.
# ⚠ THIS HALF IS VERIFIED; THE CHECKLIST IS ONLY PROMPTED. Nothing can confirm an agent read a
#   list, and a gate that cannot verify must not pretend to.
# ⚠ It is set because the failure is not hypothetical: on 2026-08-27 a commit landed with SIX
#   failing tests, because the suite and the commit were chained into one shell command and
#   the commit ran regardless of the result. This refuses the review request outright.
# ⚠ QUOTED. config.env is SOURCED by merge_branch.sh, request_review.sh and
#   review_cycle.sh. An unquoted value containing spaces aborts the source with
#   "-m: command not found" and leaves this UNSET — measured 2026-08-27, while
#   writing the comment above about settings that never fire.
SELF_REVIEW_CMD=".venv/bin/python -m pytest tests/ -q"
